# Waveshare ESP32-S3-WROOM-1-N16R8, ESP-IDF 6.1.0.
CONFIG_IDF_TARGET="esp32s3"
# DFS ceiling matches esp_pm_configure(max_freq_mhz) in main/power.c.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

# EasyTier runs its TOML parser recursively from app_main; 8 KiB is the
# component's documented requirement. Queue depths stay at the default 8,
# encryption stays on, and only two peer slots (2 x ~12 KiB) are provisioned
# for bring-up.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_EASYTIER_ESP_MAX_CONNECTED_PEERS=2
CONFIG_EASYTIER_ESP_LOG_INFO=y

# 16 MB QSPI flash and 8 MB Octal PSRAM.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

# Onboard Type-C console and flashing interface.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Power management: DFS 80/40 MHz and tickless automatic light sleep.
# The light-sleep policy follows the USB Serial/JTAG probe in main/power.c.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# Built-in safeguard: keep an ESP_PM_NO_LIGHT_SLEEP lock while the USJ host
# is attached (USJ cannot work under light sleep), release it on detach.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The setup API accepts a flat credentials object; bound the HTTP parser stack.
CONFIG_CJSON_NESTING_LIMIT=8

# HTTPS: trusted Mozilla roots, chain / hostname / time verification enabled.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# Keep large CPU-only heap blocks out of internal SRAM: TLS record buffers use
# PSRAM, and plain malloc()/calloc() prefer PSRAM above 8 KB. The RLCD DMA
# framebuffer, Wi-Fi buffers and FreeRTOS task stacks stay internal.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=8192

# Release verbosity: WARN by default. INFO remains compiled in so it can be
# raised per tag at runtime through esp_log_level_set().
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
